---
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot-grid">
    <div class="foot-brand">
      <h3>Desa Marabau</h3>
      <p>Kecamatan Pariaman Selatan, Kota Pariaman, Sumatera Barat. Portal resmi informasi & layanan warga Desa Marabau.</p>
     <div class="socials">
        <a href="mailto:desamarabau44@gmail.com" aria-label="Email Desa Marabau"><Icon name="mail" size={18} /></a>
        <a href="https://instagram.com/marabau_pariaman" target="_blank" rel="noopener noreferrer" aria-label="Instagram Desa Marabau"><Icon name="instagram" size={18} /></a>
      </div>
    </div>

    <nav class="foot-col" aria-label="Tautan cepat">
      <h4>Jelajahi</h4>
      <ul>
        <li><a href="/profil/">Profil Desa</a></li>
        <li><a href="/kondisi-desa/">Kondisi Desa</a></li>
        <li><a href="/pemerintahan/">Pemerintahan</a></li>
        <li><a href="/berita/">Berita</a></li>
        <li><a href="/galeri/">Galeri</a></li>
      </ul>
    </nav>

    <div class="foot-col">
      <h4>Kontak</h4>
      <ul class="contact-list">
        <li><Icon name="pin" size={16} /> Jl. Kompi Bakipeh, Marabau, Pariaman Selatan, Kota Pariaman, Sumatera Barat</li>
        <li><Icon name="mail" size={16} /> desamarabau44@gmail.com</li>
        <li><Icon name="clock" size={16} /> Senin&ndash;Jumat, 08.00&ndash;15.00 WIB</li>
      </ul>
    </div>

    <div class="foot-col foot-map">
      <h4>Peta Mini</h4>
      <div class="mini-map">
       <iframe
          title="Peta mini lokasi Kantor Desa Marabau"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=Kantor+Desa+Marabau,+Jl.+Kompi+Bakipeh,+Pariaman+Selatan,+Kota+Pariaman&output=embed"
        ></iframe>
      </div>
    </div>
  </div>

  <div class="foot-bottom">
    <div class="container foot-bottom-in">
      <p>&copy; {year} Pemerintah Desa Marabau. Seluruh hak cipta dilindungi.</p>
      <p>Dibangun oleh KKN UNP Tahun 2026 Desa Marabau.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-forest); color: var(--color-cream); margin-top: 0; }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr;
    gap: 40px;
    padding-block: 64px 40px;
  }
  .foot-brand .brand-mark {
    display: inline-grid; place-items: center; width: 40px; height: 40px;
    margin-bottom: 14px;
  }
  .foot-brand .brand-mark img { width: 100%; height: 100%; object-fit: contain; }
  .foot-brand h3 { color: var(--color-cream); font-size: 1.3rem; margin-bottom: 8px; }
  .foot-brand p { color: rgba(247,243,233,0.72); font-size: 0.92rem; max-width: 32ch; }
  .socials { display: flex; gap: 10px; margin-top: 16px; }
  .socials a {
    width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(247,243,233,0.1); color: var(--color-cream);
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .socials a:hover { background: var(--color-gabah); color: var(--color-forest); transform: translateY(-3px); }

  .foot-col h4 { color: var(--color-cream); font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 16px; }
  .foot-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .foot-col a { color: rgba(247,243,233,0.78); font-size: 0.92rem; transition: color var(--dur) var(--ease); }
  .foot-col a:hover { color: var(--color-gabah); }
  .contact-list li { display: flex; gap: 10px; align-items: flex-start; color: rgba(247,243,233,0.78); font-size: 0.88rem; }
  .contact-list :global(svg) { flex: none; margin-top: 2px; color: var(--color-gabah); }

  .mini-map { border-radius: var(--radius-md); overflow: hidden; border: 1px solid rgba(247,243,233,0.18); }
  .mini-map iframe { width: 100%; height: 140px; border: 0; filter: grayscale(0.15); }

  .foot-bottom { border-top: 1px solid rgba(247,243,233,0.14); }
  .foot-bottom-in {
    display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
    padding-block: 20px; font-size: 0.8rem; color: rgba(247,243,233,0.62);
  }
  .foot-bottom-in p { margin: 0; color: inherit; }

  @media (max-width: 900px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .foot-grid { grid-template-columns: 1fr; padding-block: 48px 28px; }
  }
</style>
