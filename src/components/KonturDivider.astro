---
// KonturDivider.astro — motif garis kontur sawah berundak, elemen tanda tangan visual situs.
// Dipakai sebagai pemisah antar section agar terasa "milik" identitas Desa Marabau.
interface Props {
  flip?: boolean;
  tone?: 'cream' | 'forest';
  class?: string;
}
const { flip = false, tone = 'cream', class: klass = '' } = Astro.props;
const fill = tone === 'forest' ? 'var(--color-forest)' : 'var(--color-cream)';
---
<div class={`kontur ${flip ? 'flip' : ''} ${klass}`} aria-hidden="true">
  <svg viewBox="0 0 1200 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 40 C 150 10, 300 70, 450 35 S 750 5, 900 40 S 1100 65, 1200 30 V90 H0 Z" fill={fill} opacity="0.5"/>
    <path d="M0 55 C 180 25, 320 85, 480 50 S 760 20, 920 55 S 1080 80, 1200 48 V90 H0 Z" fill={fill} opacity="0.75"/>
    <path d="M0 70 C 200 45, 340 90, 500 65 S 780 40, 940 70 S 1090 88, 1200 62 V90 H0 Z" fill={fill}/>
  </svg>
</div>

<style>
  .kontur { line-height: 0; width: 100%; }
  .kontur svg { width: 100%; height: 64px; display: block; }
  .kontur.flip { transform: scaleY(-1); }
  @media (max-width: 640px) { .kontur svg { height: 36px; } }
</style>
