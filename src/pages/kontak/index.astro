---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import KonturDivider from '../../components/KonturDivider.astro';

const kontakInfo = [
  { icon: 'pin' as const, label: 'Alamat Kantor Desa', value: 'Jl. Kompi Bakipeh, Marabau, Kec. Pariaman Selatan, Kota Pariaman, Sumatera Barat' },
  { icon: 'mail' as const, label: 'Email', value: 'marabau@pariamankota.go.id' },
  { icon: 'instagram' as const, label: 'Instagram', value: '@marabau_pariaman' },
  { icon: 'clock' as const, label: 'Jam Layanan', value: 'Senin–Jumat, 08.00–15.00 WIB' },
];

const kategoriPengaduan = [
  'Infrastruktur & Jalan',
  'Pelayanan Administrasi',
  'Kesehatan & Posyandu',
  'Lingkungan & Kebersihan',
  'Bantuan Sosial',
  'Lainnya',
];

// Alamat email tujuan pengaduan — form Opsi A akan membuka email client ke alamat ini.
const emailTujuan = 'marabau@pariamankota.go.id';
---
<BaseLayout title="Kontak & Pengaduan" description="Hubungi Pemerintah Desa Marabau atau ajukan pengaduan/aspirasi melalui formulir online.">
  <section class="page-hero photo-hero">
    <div class="hero-bg-photo" aria-hidden="true">
      <img src="/images/kontak/hubungi-kami.jpg" alt="" />
    </div>
    <div class="container">
      <p class="eyebrow">Kontak</p>
      <h1>Hubungi Kami</h1>
     <p class="lead">Sampaikan pertanyaan, aspirasi, atau pengaduan Anda kepada Pemerintah Desa Marabau melalui informasi kontak atau formulir di bawah ini.</p>
    </div>
  </section>
  <KonturDivider tone="cream" flip />

  <section class="section">
    <div class="container kontak-layout">
      <!-- INFO KONTAK -->
      <div class="kontak-info-card card" data-reveal>
        <h2>Informasi Kontak</h2>
        <ul class="kontak-list">
          {kontakInfo.map((k) => (
            <li>
              <Icon name={k.icon} size={18} />
              <div>
                <strong>{k.label}</strong>
                <p>{k.value}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- FORM PENGADUAN -->
      <div class="kontak-form-card card" data-reveal>
        <h2>Formulir Pengaduan &amp; Aspirasi</h2>
        <p class="form-desc">
          Isi formulir berikut untuk menyampaikan pengaduan atau aspirasi. Setelah menekan tombol
          kirim, aplikasi email di perangkat Anda akan terbuka dengan isi pesan yang sudah terisi
          otomatis — tinggal klik <strong>Kirim</strong> di aplikasi email tersebut.
        </p>

        <form id="form-pengaduan" class="pengaduan-form">
          <div class="form-row">
            <label for="nama">Nama Lengkap</label>
            <input type="text" id="nama" name="nama" required placeholder="Nama Anda" />
          </div>
          <div class="form-row">
            <label for="kontak">Nomor HP / WhatsApp</label>
            <input type="tel" id="kontak" name="kontak" required placeholder="08xxxxxxxxxx" />
          </div>
          <div class="form-row">
            <label for="kategori">Kategori Pengaduan</label>
            <select id="kategori" name="kategori" required>
              <option value="" disabled selected>Pilih kategori</option>
              {kategoriPengaduan.map((k) => <option value={k}>{k}</option>)}
            </select>
          </div>
          <div class="form-row">
            <label for="isi">Isi Pengaduan / Aspirasi</label>
            <textarea id="isi" name="isi" rows="5" required placeholder="Jelaskan pengaduan atau aspirasi Anda secara detail…"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            Kirim Pengaduan <Icon name="mail" size={16} />
          </button>
          <p class="form-note">Data yang Anda kirim akan diteruskan ke email resmi Desa Marabau: <strong>{emailTujuan}</strong></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: 64px 40px; }

  .photo-hero {
    position: relative;
    overflow: hidden;
    padding-block: 100px 64px;
    isolation: isolate;
  }
  .hero-bg-photo { position: absolute; inset: 0; z-index: -1; }
  .hero-bg-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .hero-bg-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(38,64,42,0.55) 0%, rgba(38,64,42,0.78) 60%, var(--color-cream) 100%);
  }
  .photo-hero .eyebrow { color: var(--color-gabah); }
  .photo-hero .eyebrow::before { background: var(--color-gabah); }
  .photo-hero h1 { color: var(--color-white); }
  .photo-hero .lead { color: rgba(255,255,255,0.9); }
  .page-hero .lead { max-width: 62ch; font-size: 1.05rem; }

  .kontak-layout { display: grid; grid-template-columns: 0.9fr 1.3fr; gap: 28px; align-items: start; }

  .kontak-info-card, .kontak-form-card { padding: 30px; }
  .kontak-info-card h2, .kontak-form-card h2 { font-size: 1.3rem; margin-bottom: 20px; }

  .kontak-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .kontak-list li { display: flex; gap: 12px; align-items: flex-start; }
  .kontak-list :global(svg) { color: var(--color-gabah-dark); flex: none; margin-top: 3px; }
  .kontak-list strong { display: block; font-size: 0.92rem; color: var(--color-forest); }
  .kontak-list p { margin: 2px 0 0; font-size: 0.88rem; }

  .form-desc { font-size: 0.92rem; margin-bottom: 22px; }

  .pengaduan-form { display: flex; flex-direction: column; gap: 16px; }
  .form-row { display: flex; flex-direction: column; gap: 6px; }
  .form-row label { font-size: 0.88rem; font-weight: 700; color: var(--color-forest); }
  .form-row input, .form-row select, .form-row textarea {
    font: inherit;
    padding: 11px 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    color: var(--color-ink);
    resize: vertical;
  }
  .form-row input:focus, .form-row select:focus, .form-row textarea:focus {
    outline: none;
    border-color: var(--color-gabah);
    box-shadow: 0 0 0 3px rgba(200,155,60,0.25);
  }
  .form-note { font-size: 0.8rem; color: var(--color-ink-soft); margin-top: 4px; }

  @media (max-width: 860px) {
    .kontak-layout { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ emailTujuan }}>
  const form = document.getElementById('form-pengaduan');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nama = data.get('nama');
    const kontak = data.get('kontak');
    const kategori = data.get('kategori');
    const isi = data.get('isi');

    const subject = `Pengaduan Warga: ${kategori}`;
    const body =
      `Nama: ${nama}\n` +
      `Nomor HP/WhatsApp: ${kontak}\n` +
      `Kategori: ${kategori}\n\n` +
      `Isi Pengaduan:\n${isi}`;

    const mailtoUrl = `mailto:${emailTujuan}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailtoUrl;
  });
</script>