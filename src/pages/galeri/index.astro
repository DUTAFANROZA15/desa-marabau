---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import KonturDivider from '../../components/KonturDivider.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('galeri')).sort(
  (a, b) => (b.data.tanggal?.getTime() ?? 0) - (a.data.tanggal?.getTime() ?? 0)
);
const kategoriList = ['Semua', ...Array.from(new Set(items.map((i) => i.data.kategori)))];
---
<BaseLayout title="Galeri" description="Dokumentasi foto dan video kegiatan, alam, budaya, dan infrastruktur Desa Marabau.">
  <section class="page-hero photo-hero">
    <div class="hero-bg-photo" aria-hidden="true">
      <img src="/images/galeri/galeri.jpg" alt="" />
    </div>
    <div class="container">
      <p class="eyebrow">Galeri</p>
      <h1>Dokumentasi Desa Marabau</h1>
      <p class="lead">Kumpulan foto dan video kegiatan warga, keindahan alam, dan perkembangan pembangunan desa.</p>
    </div>
  </section>

  <KonturDivider tone="cream" flip />

  <section class="section">
    <div class="container">
      <div class="filter-chips" role="group" aria-label="Filter kategori galeri">
        {kategoriList.map((k, i) => (
          <button type="button" class="chip" data-kategori={k} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>
        ))}
      </div>

      <div class="gallery-grid" id="gallery-grid">
        {items.map((item, i) => (
          <button
            type="button"
            class="g-tile"
            data-kategori={item.data.kategori}
            data-index={i}
            data-tipe={item.data.tipe}
            data-youtube={item.data.youtubeId || ''}
            data-judul={item.data.judul}
            aria-label={`Perbesar: ${item.data.judul}`}
          >
            <Illustration variant={(item.data.gambar as any) || 'sawah'} title={item.data.judul} />
            {item.data.tipe === 'video' && <span class="play-badge"><Icon name="play" size={20} /></span>}
            <span class="g-caption">{item.data.judul}<em>{item.data.kategori}</em></span>
          </button>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" hidden>
  <div class="lightbox-backdrop" data-close></div>
  <div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Pratinjau galeri">
    <button type="button" class="lb-close" data-close aria-label="Tutup"><Icon name="close" size={22} /></button>
    <button type="button" class="lb-nav lb-prev" data-prev aria-label="Sebelumnya"><Icon name="chevron-right" size={26} class="rotate" /></button>
    <div class="lb-media" id="lb-media"></div>
    <p class="lb-caption" id="lb-caption"></p>
    <button type="button" class="lb-nav lb-next" data-next aria-label="Berikutnya"><Icon name="chevron-right" size={26} /></button>
  </div>
</div>

<style>
  .page-hero { padding-block: 64px 40px; }

  .photo-hero {
    position: relative;
    overflow: hidden;
    padding-block: 100px 64px;
    isolation: isolate;
  }
  .hero-bg-photo { position: absolute; inset: 0; z-index: -1; }
  .hero-bg-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .hero-bg-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(38,64,42,0.55) 0%, rgba(38,64,42,0.78) 60%, var(--color-cream) 100%);
  }
  .photo-hero .eyebrow { color: var(--color-gabah); }
  .photo-hero .eyebrow::before { background: var(--color-gabah); }
  .photo-hero h1 { color: var(--color-white); }
  .photo-hero .lead { color: rgba(255,255,255,0.9); }
  .page-hero .lead { max-width: 62ch; font-size: 1.05rem; }

  .filter-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 30px; }
  .chip {
    border: 1px solid var(--color-line); background: var(--color-white); border-radius: 999px;
    padding: 8px 16px; font-size: 0.86rem; font-weight: 600; cursor: pointer; color: var(--color-ink);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .chip[aria-pressed='true'] { background: var(--color-forest); color: var(--color-cream); border-color: var(--color-forest); }

  .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .g-tile {
    position: relative; border: none; padding: 0; cursor: pointer; border-radius: var(--radius-sm);
    overflow: hidden; aspect-ratio: 1; background: none; display: block;
  }
  .g-tile :global(svg) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .g-tile:hover :global(svg) { transform: scale(1.08); }
  .play-badge {
    position: absolute; inset: 0; margin: auto; width: 48px; height: 48px; border-radius: 50%;
    background: rgba(38,64,42,0.75); color: #fff; display: grid; place-items: center;
  }
  .g-caption {
    position: absolute; inset: auto 0 0 0; padding: 10px 12px 8px; text-align: left;
    background: linear-gradient(0deg, rgba(0,0,0,0.6), transparent);
    color: #fff; font-size: 0.8rem; font-weight: 700; display: flex; flex-direction: column; gap: 2px;
  }
  .g-caption em { font-style: normal; font-weight: 500; font-size: 0.7rem; opacity: 0.8; }

  .lightbox[hidden] { display: none; }
  .lightbox { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; }
  .lightbox-backdrop { position: absolute; inset: 0; background: rgba(20, 24, 16, 0.88); }
  .lightbox-panel {
    position: relative; z-index: 1; width: min(90vw, 820px); max-height: 88vh;
    background: var(--color-cream); border-radius: var(--radius-lg); padding: 20px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .lb-media { border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 16/9; background: #000; }
  .lb-media :global(svg), .lb-media iframe { width: 100%; height: 100%; object-fit: cover; border: 0; }
  .lb-caption { margin: 0; text-align: center; font-weight: 700; color: var(--color-forest); }
  .lb-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; background: var(--color-forest); color: var(--color-cream); border: none; display: grid; place-items: center; cursor: pointer; }
  .lb-nav { position: absolute; top: 50%; translate: 0 -50%; width: 44px; height: 44px; border-radius: 50%; background: var(--color-white); border: none; display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow-card); }
  .lb-prev { left: -14px; }
  .lb-prev :global(.rotate) { transform: rotate(180deg); }
  .lb-next { right: -14px; }

  @media (max-width: 900px) { .gallery-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .lb-nav { display: none; }
  }
</style>

<script>
  // Filter kategori
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.g-tile'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      const k = chip.dataset.kategori;
      tiles.forEach((t) => {
        t.style.display = k === 'Semua' || t.dataset.kategori === k ? '' : 'none';
      });
    });
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const media = document.getElementById('lb-media') as HTMLElement;
  const caption = document.getElementById('lb-caption') as HTMLElement;
  let currentIndex = 0;

  function visibleTiles() {
    return tiles.filter((t) => t.style.display !== 'none');
  }

  function openAt(index: number) {
    const vis = visibleTiles();
    if (!vis.length) return;
    currentIndex = (index + vis.length) % vis.length;
    const tile = vis[currentIndex];
    const tipe = tile.dataset.tipe;
    const judul = tile.dataset.judul || '';
    if (tipe === 'video' && tile.dataset.youtube) {
      media.innerHTML = `<iframe src="https://www.youtube.com/embed/${tile.dataset.youtube}" title="${judul}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    } else {
      const svg = tile.querySelector('svg');
      media.innerHTML = svg ? svg.outerHTML : '';
    }
    caption.textContent = judul;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  tiles.forEach((tile, i) => tile.addEventListener('click', () => openAt(i)));

  function close() {
    lightbox.hidden = true;
    media.innerHTML = '';
    document.body.style.overflow = '';
  }

  lightbox.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
  lightbox.querySelector('[data-prev]')?.addEventListener('click', () => openAt(currentIndex - 1));
  lightbox.querySelector('[data-next]')?.addEventListener('click', () => openAt(currentIndex + 1));
  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') openAt(currentIndex - 1);
    if (e.key === 'ArrowRight') openAt(currentIndex + 1);
  });
</script>
