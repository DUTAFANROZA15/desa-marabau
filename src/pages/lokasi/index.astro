---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import KonturDivider from '../../components/KonturDivider.astro';

const koordinat = { lat: -0.6353, lng: 100.1507 };
const bbox = '100.1257,0.6103,100.1757,0.6603';

const akses = [
  { icon: 'flag' as const, title: 'Dari Pusat Kecamatan', desc: 'Sekitar 2,0 km, dapat ditempuh 5–8 menit menggunakan kendaraan bermotor.' },
  { icon: 'building' as const, title: 'Dari Pusat Kota Pariaman', desc: 'Sekitar 3,5 km melalui jalan kabupaten yang sudah beraspal baik.' },
  { icon: 'map' as const, title: 'Kondisi Jalan', desc: 'Jalan utama desa sudah beraspal/beton; sebagian jalan lingkungan dusun masih dalam tahap pengerasan.' },
];
---
<BaseLayout title="Lokasi" description="Peta, alamat kantor desa, koordinat, dan akses transportasi menuju Desa Marabau.">
  <section class="page-hero photo-hero">
    <div class="hero-bg-photo" aria-hidden="true">
      <img src="/images/profil/lokasi.jpg" alt="" />
    </div>
    <div class="container">
      <p class="eyebrow">Lokasi</p>
      <h1>Menuju Desa Marabau</h1>
      <p class="lead">Kantor Desa Marabau berlokasi di Jalan Kompi Bakipeh, Kecamatan Pariaman Selatan, Kota Pariaman — mudah dijangkau dari pusat kota.</p>
    </div>
  </section>
  <KonturDivider tone="cream" flip />

  <section class="section">
    <div class="container map-layout">
      <div class="map-frame card" data-reveal>
       <iframe
          title="Peta lokasi Kantor Desa Marabau"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=Kantor+Desa+Marabau,+Jl.+Kompi+Bakipeh,+Pariaman+Selatan,+Kota+Pariaman&output=embed"
        ></iframe>
      </div>

      <aside class="info-card card" data-reveal>
        <h2>Informasi Alamat</h2>
        <ul class="info-list">
          <li>
            <Icon name="pin" size={18} />
            <div>
              <strong>Alamat Kantor Desa</strong>
              <p>Jl. Kompi Bakipeh, Marabau, Kec. Pariaman Selatan, Kota Pariaman, Sumatera Barat</p>
            </div>
          </li>
          <li>
            <Icon name="map" size={18} />
            <div>
              <strong>Koordinat</strong>
              <p>0°38′07″S 100°09′02″E ({Math.abs(koordinat.lat)}°S, {koordinat.lng}°E)</p>
            </div>
          </li>
          <li>
            <Icon name="clock" size={18} />
            <div>
              <strong>Jam Layanan</strong>
              <p>Senin–Jumat, 08.00–15.00 WIB</p>
            </div>
          </li>
        </ul>
        <a
           class="btn btn-primary full"
          href="https://www.google.com/maps/search/?api=1&query=Kantor+Desa+Marabau+Pariaman+Selatan+Kota+Pariaman"
          target="_blank" rel="noopener noreferrer"
        >
          Buka di Google Maps <Icon name="external-link" size={16} />
        </a>
      </aside>
    </div>
  </section>

  <section class="section akses-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Akses & Transportasi</p>
        <h2>Petunjuk Arah Menuju Desa</h2>
      </div>
      <div class="akses-grid" data-reveal-group>
        {akses.map((a) => (
          <div class="akses-card card" data-reveal>
            <span class="akses-icon"><Icon name={a.icon} size={22} strokeWidth={1.7} /></span>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: 64px 40px; }

  .photo-hero {
    position: relative;
    overflow: hidden;
    padding-block: 100px 64px;
    isolation: isolate;
  }
  .hero-bg-photo { position: absolute; inset: 0; z-index: -1; }
  .hero-bg-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .hero-bg-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(38,64,42,0.55) 0%, rgba(38,64,42,0.78) 60%, var(--color-cream) 100%);
  }
  .photo-hero .eyebrow { color: var(--color-gabah); }
  .photo-hero .eyebrow::before { background: var(--color-gabah); }
  .photo-hero h1 { color: var(--color-white); }
  .photo-hero .lead { color: rgba(255,255,255,0.9); }
  .page-hero .lead { max-width: 62ch; font-size: 1.05rem; }

  .map-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 28px; align-items: stretch; }
  .map-frame { padding: 0; overflow: hidden; min-height: 420px; }
  .map-frame iframe { width: 100%; height: 100%; min-height: 420px; border: 0; }

  .info-card { padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  .info-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .info-list li { display: flex; gap: 12px; align-items: flex-start; }
  .info-list :global(svg) { color: var(--color-gabah-dark); flex: none; margin-top: 3px; }
  .info-list strong { display: block; color: var(--color-forest); font-size: 0.94rem; }
  .info-list p { margin: 2px 0 0; font-size: 0.9rem; }
  .btn.full { width: 100%; justify-content: center; margin-top: auto; }

  .akses-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .akses-card { padding: 24px; }
  .akses-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--color-cream-2); color: var(--color-forest); margin-bottom: 12px; }

  @media (max-width: 900px) {
    .map-layout { grid-template-columns: 1fr; }
    .akses-grid { grid-template-columns: 1fr; }
  }
</style>
