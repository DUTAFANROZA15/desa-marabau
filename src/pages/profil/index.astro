---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KonturDivider from '../../components/KonturDivider.astro';
import { getEntry, render } from 'astro:content';

const sejarah = await getEntry('profil', 'sejarah');
const visiMisi = await getEntry('profil', 'visi-misi');
const potensi = await getEntry('profil', 'potensi');

const { Content: SejarahContent } = await render(sejarah!);
const { Content: VisiMisiContent } = await render(visiMisi!);
const { Content: PotensiContent } = await render(potensi!);

const subnav = [
  { id: 'sejarah', label: 'Sejarah' },
  { id: 'visi-misi', label: 'Visi & Misi' },
  { id: 'potensi', label: 'Potensi & Budaya' },
];
---
<BaseLayout title="Profil Desa" description="Sejarah, visi misi, serta potensi dan budaya Desa Marabau.">
 <section class="page-hero photo-hero">
    <div class="hero-bg-photo" aria-hidden="true">
      <img src="/images/profil/sawah-marabau.jpg" alt="" />
    </div>
    <div class="container">
      <p class="eyebrow">Profil Desa</p>
      <h1>Mengenal Lebih Dekat Desa Marabau</h1>
      <p class="lead">Sejarah, arah pembangunan, hingga potensi dan budaya yang menghidupi keseharian warga.</p>
    </div>
  </section>
  <KonturDivider tone="cream" flip />

  <div class="subnav-wrap">
    <nav class="subnav container" aria-label="Navigasi bagian profil">
      {subnav.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>
  </div>

<section id="sejarah" class="section profil-block">
    <div class="container two-col">
      <div class="prose" data-reveal>
        <p class="eyebrow">01 &middot; Sejarah</p>
        <h2>{sejarah?.data.title}</h2>
        <SejarahContent />
      </div>
      <div class="art" data-reveal>
        <img src="/images/profil/kantor-desa-marabau.jpg" alt="Papan informasi Kantor Desa Marabau" />
      </div>
    </div>
  </section>

 <section id="visi-misi" class="section profil-block alt">
    <div class="container two-col reverse">
      <div class="art" data-reveal>
        <img src="/images/profil/plang-kantor-desa-marabau.jpg" alt="Plang Kantor Desa Marabau" />
      </div>
      <div class="prose" data-reveal>
        <p class="eyebrow">02 &middot; Visi &amp; Misi</p>
        <h2>{visiMisi?.data.title}</h2>
        <VisiMisiContent />
      </div>
    </div>
  </section>

  <section id="potensi" class="section profil-block">
    <div class="container two-col">
      <div class="prose" data-reveal>
        <p class="eyebrow">03 &middot; Potensi &amp; Budaya</p>
        <h2>{potensi?.data.title}</h2>
        <PotensiContent />
      </div>
      <div class="art" data-reveal>
        <img src="/images/profil/potensi-pertanian-peternakan.jpg" alt="Potensi pertanian, peternakan, dan kehidupan sosial masyarakat Desa Marabau" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: 64px 40px; }

  .photo-hero {
    position: relative;
    overflow: hidden;
    padding-block: 100px 64px;
    isolation: isolate;
  }
  .hero-bg-photo { position: absolute; inset: 0; z-index: -1; }
  .hero-bg-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .hero-bg-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(38,64,42,0.55) 0%, rgba(38,64,42,0.78) 60%, var(--color-cream) 100%);
  }
  .photo-hero .eyebrow { color: var(--color-gabah); }
  .photo-hero .eyebrow::before { background: var(--color-gabah); }
  .photo-hero h1 { color: var(--color-white); }
  .photo-hero .lead { color: rgba(255,255,255,0.9); }
  .page-hero .lead { font-size: 1.05rem; max-width: 60ch; }

  .subnav-wrap { position: sticky; top: 72px; z-index: 40; background: var(--color-cream); border-bottom: 1px solid var(--color-line); }
  .subnav { display: flex; gap: 6px; padding-block: 10px; overflow-x: auto; }
  .subnav a {
    padding: 8px 16px; border-radius: 999px; font-weight: 600; font-size: 0.88rem;
    white-space: nowrap; color: var(--color-ink-soft); transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .subnav a:hover { background: var(--color-cream-2); color: var(--color-forest); }

  .profil-block.alt { background: var(--color-cream-2); }
  .two-col { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .two-col.reverse { grid-template-columns: 0.9fr 1.1fr; }
  .two-col.reverse .art { order: -1; }
  .art { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-soft); aspect-ratio: 4/3; }
#potensi .art { aspect-ratio: 3/4; }
.art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .prose :global(h2) { margin-bottom: 0.5em; }
  .prose :global(blockquote) {
    margin: 1.2em 0; padding: 16px 20px; border-left: 4px solid var(--color-gabah);
    background: var(--color-white); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-family: var(--font-display); font-style: italic; color: var(--color-forest);
  }
  .prose :global(ol), .prose :global(ul) { color: var(--color-ink-soft); }
  .prose :global(li) { margin-bottom: 0.4em; }

  @media (max-width: 860px) {
    .two-col, .two-col.reverse { grid-template-columns: 1fr; gap: 28px; }
    .two-col.reverse .art { order: 0; }
    .subnav-wrap { top: 64px; }
  }
</style>
